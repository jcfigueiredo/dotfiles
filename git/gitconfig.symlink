# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[hub]
        protocol = https
[alias]
        co = checkout
        promote = !$DOTFILES/bin/git-promote
        wtf     = !$DOTFILES/bin/git-wtf
        rank-contributors = !$DOTFILES/bin/git-rank-contributors
        count   = !git shortlog -sn
	st = status
	ci = commit
	graph = log --oneline --graph --decorate
	br = branch

[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor =  vim 
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
        default = simple
[credential]
	helper = osxkeychain

[includeIf "gitdir:~/projects/ideastream/**"]
    path="~/work.gitconfig"


[init]
    defaultBranch = main
[includeIf "gitdir:/Users/claudio/projects/csouza/"]
	path = /Users/claudio/.gitconfig-csouza
[includeIf "gitdir:/Users/claudio/projects/personal/"]
	path = /Users/claudio/.gitconfig-personal
[includeIf "gitdir:/Users/claudio/projects/bithippie/"]
	path = /Users/claudio/.gitconfig-bithippie
